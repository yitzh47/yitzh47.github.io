# --- Core ---
NODE_ENV=production
PORT=3000
BASE_URL=https://www.yourstore.com
SESSION_SECRET=generate-a-long-random-string
DB_PATH=./data/store.db

# --- Store identity (used in SEO structured data, emails, llms.txt) ---
STORE_NAME=Cloudline Vapor
STORE_TAGLINE=Premium vapes, e-liquids & hardware — shipped fast to adults 21+
STORE_EMAIL=support@yourstore.com
STORE_PHONE=+1-555-010-0100
STORE_STREET=100 Main St
STORE_CITY=Austin
STORE_REGION=TX
STORE_POSTAL=78701
STORE_COUNTRY=US
STORE_SOCIAL=https://instagram.com/yourstore,https://x.com/yourstore

# --- Commerce / compliance ---
MIN_AGE=21
FREE_SHIPPING_THRESHOLD=75
FLAT_SHIPPING=7.95
TAX_RATE=0.0825
# Review with counsel; vape shipping laws change often.
RESTRICTED_STATES=MA,ME,UT,VT,OR,AR,SD,ND,NM,DC
LEAD_DISCOUNT_CODE=WELCOME15
LEAD_DISCOUNT_PCT=15

# --- Payments (demo | authorizenet) ---
PAYMENT_PROVIDER=authorizenet
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_SIGNATURE_KEY=
AUTHNET_SANDBOX=true

# --- Email (console | resend) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Cloudline Vapor <hello@yourstore.com>

# --- Admin ---
ADMIN_EMAIL=you@yourstore.com
ADMIN_PASSWORD=change-me

# --- Analytics (optional) ---
GA_MEASUREMENT_ID=
